# Application
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-fixnet-backend-key
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,web
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@db:5432/fixnet_db
DB_NAME=fixnet_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Security & JWT
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
JWT_ISSUER=fixnet-auth-service

# External Gateways & Integrations
# SMS Providers
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your-africas-talking-api-key
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Payments (Mobile Money & Cards)
MOMO_API_URL=https://aggregator.sandbox.fixnet.rw/v1
MOMO_API_KEY=your-momo-api-key
PAYMENT_WEBHOOK_SECRET=your-webhook-signature-secret

# AWS S3 Storage (Presigned URLs & Media)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=fixnet-private-docs
AWS_S3_REGION_NAME=af-south-1

# Monitoring & Logging
SENTRY_DSN=
